{
  "name": "hisabkit-monorepo",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "typecheck": "turbo typecheck",
    "typecheck:ci": "turbo typecheck --log-prefix=none",
    "test": "turbo test",
    "check": "turbo lint typecheck test build",
    "check:all": "turbo lint typecheck test build",
    "format": "biome format --write .",
    "clean": "turbo clean",
    "predev": "npm run env:check",
    "env:check": "dotenv-checker --env .env --schema .env.example",
    "packages:sync": "syncpack list-mismatches && syncpack fix-mismatches",
    "changeset": "changeset",
    "version:ci": "changeset version && npm run build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@changesets/cli": "2.30.0",
    "@react-native-community/cli-server-api": "^20.1.3",
    "dotenv-checker": "1.1.7",
    "husky": "^9.1.5",
    "lint-staged": "^15.5.2",
    "syncpack": "14.3.0",
    "turbo": "^2.3.4",
    "typescript": "5.9.3"
  },
  "lint-staged": {
    "**/*.{js,ts,tsx,jsx,json,css}": "biome check --write --no-errors-on-unmatched"
  },
  "packageManager": "npm@10.2.4",
  "overrides": {
    "metro": "0.80.12",
    "metro-config": "0.80.12",
    "metro-resolver": "0.80.12",
    "metro-runtime": "0.80.12",
    "metro-core": "0.80.12",
    "metro-cache": "0.80.12",
    "metro-transform-worker": "0.80.12",
    "metro-transform-plugins": "0.80.12"
  },
  "dependencies": {
    "metro": "0.80.12",
    "metro-babel-transformer": "0.80.12",
    "metro-config": "0.80.12",
    "metro-core": "0.80.12",
    "metro-resolver": "0.80.12",
    "metro-runtime": "0.80.12"
  }
}
