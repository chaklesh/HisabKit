{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "target/**"]
    },
    "lint": {
      "cache": true
    },
    "lint:fix": {
      "cache": false
    },
    "typecheck": {
      "cache": true
    },
    "test": {
      "outputs": ["coverage/**"],
      "cache": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false,
      "outputs": ["dist/**", ".next/**", "target/**", "node_modules/.cache/turbo"]
    },
    "api#build": {
      "dependsOn": ["^build"],
      "outputs": ["target/**"]
    },
    "api#test": {
      "outputs": ["target/surefire-reports/**"]
    }
  }
}
