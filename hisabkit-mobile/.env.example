# HisabKit Mobile - Environment Variables
# Copy this file to .env and fill in actual values.
# All variables prefixed with EXPO_PUBLIC_ are accessible in the app bundle.

# Backend API base URL (no trailing slash)
EXPO_PUBLIC_API_BASE_URL=https://hisabkit.nayag.com/api

# Optional fallback Google OAuth Client ID used when platform-specific IDs are not set
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Recommended: platform-specific Google OAuth Client IDs
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
