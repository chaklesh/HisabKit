SPRING_PROFILES_ACTIVE=dev

# Required for JWT signing (use a long random string, min 32 chars)
JWT_SECRET=replace-with-strong-secret-min-32-bytes

# Google One Tap / Sign-In client id (Web app OAuth client id)
GOOGLE_CLIENT_ID=replace-with-google-web-client-id

# Allowed CORS origins (comma-separated)
# Dev: http://localhost:3010
# Prod: https://hisabkit.nayag.com
CORS_ALLOWED_ORIGINS=http://localhost:3010

# Bootstrap super admin (first-time setup only)
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_TENANT_NAME=
BOOTSTRAP_ADMIN_TENANT_SLUG=
BOOTSTRAP_ADMIN_BUSINESS_TYPE=System
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Dev DB (H2 file-based) — only used when SPRING_PROFILES_ACTIVE=dev
DEV_DB_USER=sa
DEV_DB_PASSWORD=password

# Prod DB (Hestia-managed MariaDB) — only used when SPRING_PROFILES_ACTIVE=prod
# If running inside Docker: DB_HOST=host.docker.internal
# If running on bare metal: DB_HOST=127.0.0.1
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=hisabkit_prod
DB_USER=hisabkit_user
DB_PASSWORD=replace-with-strong-db-password

# Upload directory (persist via Docker volume in prod)
UPLOAD_DIR=./uploads

# Server port (default is 8010)
SERVER_PORT=8010
