<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="5" author="hisabkit-social-auth">
        <addColumn tableName="users">
            <column name="google_subject" type="VARCHAR(255)"/>
            <column name="full_name" type="VARCHAR(255)"/>
            <column name="avatar_url" type="VARCHAR(1000)"/>
        </addColumn>

        <addUniqueConstraint tableName="users"
                             columnNames="google_subject"
                             constraintName="uk_users_google_subject"/>
    </changeSet>

</databaseChangeLog>
