{
  "expo": {
    "name": "HisabKit",
    "slug": "hisabkit-mobile",
    "scheme": "hisabkit",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#0f172a"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to unlock your HisabKit ledger."
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.nayag.hisabkit",
      "supportsTablet": true
    },
    "android": {
      "package": "com.nayag.hisabkit",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "d41dafbd-a26c-486a-98b9-7ec9c0e2e069"
      },
      "google": {
        "androidClientId": "964754530671-68v7geqba4cuh2dbmtgr2e4jl76h6aba.apps.googleusercontent.com",
        "webClientId": "964754530671-a38f6mbkbod3mk99md0upp4onrbib9cs.apps.googleusercontent.com",
        "iosClientId": "964754530671-7c7p8drg6c4vpgcioa1i3hjf4ue8p30o.apps.googleusercontent.com"
      }
    }
  }
}

